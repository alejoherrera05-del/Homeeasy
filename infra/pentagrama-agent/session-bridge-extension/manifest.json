{
  "manifest_version": 3,
  "name": "HomeEasy Pentagrama Session Bridge",
  "version": "1.0.3",
  "description": "Puente local seguro entre la sesión real de Pentagrama en Brave y HomeEasy.",
  "key": "",
  "permissions": ["cookies", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://pedidos.persianaspentagrama.com/*",
    "http://127.0.0.1:38461/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pedidos.persianaspentagrama.com/Login*",
        "https://pedidos.persianaspentagrama.com/User/Login*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "HomeEasy Pentagrama Session Bridge"
  }
}
