<service>
  <id>HomeEasyPentagramaAgent</id>
  <name>HomeEasy Pentagrama Agent</name>
  <description>Conector seguro de solo lectura entre HomeEasy y Pentagrama.</description>
  <executable>%BASE%\runtime\node.exe</executable>
  <arguments>"%BASE%\app\src\agent.js"</arguments>
  <workingdirectory>%BASE%\app</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>45 sec</stoptimeout>
  <log mode="roll-by-size-time">
    <sizeThreshold>2048</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
    <zipDateFormat>yyyyMM</zipDateFormat>
  </log>
</service>
