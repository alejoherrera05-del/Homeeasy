# NUNCA pongas secretos reales en GitHub.
# En el VPS copia este archivo a .env y reemplaza los valores CHANGE_ME.

# WAHA
WAHA_API_KEY=CHANGE_ME_WAHA_API_KEY
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD
WAHA_SESSION=homeeasy

# HomeEasy WhatsApp Bridge
BRIDGE_TOKEN=CHANGE_ME_BRIDGE_TOKEN
BRIDGE_PORT=8080
MAX_BODY_MB=18

# HomeEasy Pentagrama Sync (solo lectura). Configurar únicamente en el VPS.
PENTAGRAMA_LOGIN=CHANGE_ME_PENTAGRAMA_LOGIN
PENTAGRAMA_PASSWORD=CHANGE_ME_PENTAGRAMA_PASSWORD
PENTAGRAMA_TIMEOUT_MS=20000
PENTAGRAMA_MODE=direct
PENTAGRAMA_AGENT_BOOTSTRAP_TOKEN=CHANGE_ME_AGENT_BOOTSTRAP_TOKEN
PENTAGRAMA_AGENT_TLS_PORT=8443
PENTAGRAMA_AGENT_TLS_CERT=/app/agent-tls/server.crt
PENTAGRAMA_AGENT_TLS_KEY=/app/agent-tls/server.key
PENTAGRAMA_AGENT_PUBLIC_PORT=8443
PENTAGRAMA_AGENT_LATEST_VERSION=1.0.0
HOMEEASY_PENTAGRAMA_SYNC_KEY=CHANGE_ME_RANDOM_SERVICE_KEY

# Entorno
TZ=America/Bogota
