# Required for Hommy AI (preferred over the legacy Render Secret File config.py)
OPENAI_API_KEY=

# Optional: dedicated signing secret. If omitted, Hommy derives a signer from OPENAI_API_KEY.
HOMMY_CONVERSATION_SECRET=
HOMMY_SAFETY_SALT=

# Models
HOMMY_MODEL=gpt-5.6-terra
HOMMY_REASONING_EFFORT=low
HOMMY_REALTIME_MODEL=gpt-realtime-2.1
HOMMY_REALTIME_VOICE=cedar

# Existing HomeEasy services
HOMEEASY_BACKEND_URL=https://script.google.com/macros/s/AKfycbyZHaIe7hb28KKtaPBORASy_maSZ2co8dZFce44GQRiZGYg_6WoU7qn4qC-lYCQO6ZL/exec
HOMEEASY_SHEET_ID=1hnHAeKhyd9MVCn1bCm8XExl4hdV2ijqdIjCXoJba1iY

# Google service account: prefer JSON env; legacy credenciales.json remains supported.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cache / security
HOMMY_DATA_TTL_SECONDS=30
HOMMY_DATA_STALE_SECONDS=180
HOMMY_DATA_REFRESH_WAIT_SECONDS=30
HOMMY_SHEETS_CONNECT_TIMEOUT_SECONDS=5
HOMMY_SHEETS_READ_TIMEOUT_SECONDS=20
HOMMY_AUTH_CACHE_SECONDS=45
HOMMY_CONVERSATION_MAX_AGE_SECONDS=604800
HOMMY_ALLOWED_ORIGINS=https://alejoherrera05-del.github.io
HOMMY_OPENAI_TIMEOUT_SECONDS=55
HOMMY_OPENAI_MAX_RETRIES=1
HOMMY_RATE_CHAT_PER_MINUTE=20
HOMMY_RATE_TOOL_PER_MINUTE=60
HOMMY_RATE_REALTIME_SESSION_PER_MINUTE=8
HOMMY_RATE_SYNC_PER_MINUTE=60

# Commercial configuration (review before production if business rules change)
HOMMY_INSTALL_DEFAULT=30000
HOMMY_INSTALL_ONDA=50000
HOMMY_VAT_RATE=0.19
HOMMY_TRANSPORT=50000
